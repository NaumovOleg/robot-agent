{
  "name": "robot-agent",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.0.9",
  "workspaces": [
    "apps/cli",
    "packages/*"
  ],
  "pnpm": {
    "overrides": {
      "react": "18.3.1",
      "ink": "5.2.1",
      "@inkjs/ui": "2.0.0"
    }
  },
  "scripts": {
    "build": "pnpm --filter @robocode-packages/core build && pnpm --filter @robocode-packages/shared build && pnpm --filter @robocode-packages/config build && pnpm --filter @robocode-packages/providers build && pnpm --filter @robocode-packages/tools build && pnpm --filter @robocode-packages/agent build && pnpm --filter @robocode-packages/ui build && pnpm --filter @robocode-packages/cli build",
    "start": "node apps/cli/dist/index.js",
    "dev": "pnpm --filter robocode dev",
    "lint": "eslint . --ext .ts,.tsx",
    "clean": "rm -rf node_modules **/node_modules **/dist",
    "bootstrap": "pnpm install && pnpm -r run build",
    "debug": "tail -f ~/.robocode/debug.log"
  },
  "dependencies": {
    "@changesets/cli": "^2.31.0",
    "@eslint/js": "^10.0.1",
    "@inkjs/ui": "^2.0.0",
    "@types/node": "^25.6.2",
    "commander": "^10.0.0",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "dotenv": "^16.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.6.0",
    "nodemon": "^3.1.14",
    "react": "^18.2.0",
    "react-ink": "^5.1.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsup": "^6.7.0",
    "tsx": "^3.12.7",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.2",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "eslint": "^10.3.0"
  }
}
