{
  "version": "0.2.0",

  "configurations": [
    {
      "name": "Debug pnpm start",

      "type": "node",

      "request": "launch",

      "cwd": "${workspaceFolder}/apps/cli",

      "runtimeExecutable": "pnpm",

      "runtimeArgs": ["dev"],

      "console": "integratedTerminal",

      "internalConsoleOptions": "neverOpen",

      "skipFiles": ["<node_internals>/**"],

      "env": {
        "NODE_ENV": "development"
      }
    }
  ]
}
