{
  "name": "robocode",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "robocode": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "chokidar 'src/**/*.{ts,tsx}' '../../packages/*/src/**/*.{ts,tsx}' -c 'tput reset && tsx -r tsconfig-paths/register src/index.ts' --initial --debounce 500",
    "build": "tsup",
    "start": "node dist/index.js",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@inkjs/ui": "^2.0.0",
    "@langchain/core": "1.1.45",
    "@robocode-packages/agent": "workspace:*",
    "@robocode-packages/config": "workspace:*",
    "@robocode-packages/core": "workspace:*",
    "@robocode-packages/providers": "workspace:*",
    "@robocode-packages/shared": "workspace:*",
    "@robocode-packages/tools": "workspace:*",
    "commander": "^10.0.0",
    "dotenv": "^16.0.0",
    "ink": "^5.2.1",
    "ink-select-input": "^6.2.0",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "react": "^18.3.1",
    "tsx": "^3.12.7"
  },
  "devDependencies": {
    "@types/node": "^25.6.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "chokidar-cli": "^3.0.0"
  }
}
